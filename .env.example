POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger?sslmode=disable
API_ADDR=:8080
MIGRATIONS_PATH=migrations
LOG_LEVEL=debug
LOG_FORMAT=text

# DynamoDB / MiniStack (CQRS Read Model)
DYNAMODB_ENDPOINT=http://localhost:4566
DYNAMODB_REGION=us-east-1
DYNAMODB_TABLE=goledge_projections

# AWS SNS & SQS (Event-Driven Messaging)
AWS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:ledger-events
SQS_WALLET_BALANCE_QUEUE_URL=http://localhost:4566/000000000000/wallet-balance-projections-queue
